          "label": "Metric above threshold",
          "type": "number",
          "params": [
            {
              "name": "metric",
              "label": "Metric",
              "type": "enum",
              "required": true,
              "options": [
                "temperature_c",
                "humidity_percent",
                "pressure_hpa",
                "battery_percent",
                "illuminance_lux",
