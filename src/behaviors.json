  "templates": [
    {
      "id": "aqara_contact_open_alert",
      "label": "Tell me when an Aqara contact sensor opens",
      "description": "Starts from Aqara cloud updates and gives you a simple alert for doors, windows, or similar contact sensors.",
      "category": "Security",
      "deviceKey": "aqara_cloud_device",
      "config": {
        "automation_schema_version": "automation.behavior.v2",
        "triggers": [
          {
            "id": "state_changed",
            "label": "Aqara device updates",
            "type": "integration_event",
            "event": "device.state_changed",
            "capability": "telemetry.state",
            "enabled": true,
            "sourceRef": {
              "integrationId": "{{integrationId}}",
              "integrationKey": "{{integrationKey}}",
              "configId": "{{configId}}",
              "behaviorDeviceKey": "aqara_cloud_device",
              "optionKey": "state_changed",
              "capability": "telemetry.state"
            }
          }
        ],
        "trigger": {
          "id": "state_changed",
          "label": "Aqara device updates",
          "type": "integration_event",
          "event": "device.state_changed",
          "capability": "telemetry.state",
          "enabled": true
        },
        "intent": "environment_monitoring",
        "conditionTree": {
          "id": "contact_open",
          "label": "Contact is open",
          "field": "contact_open",
          "operator": "eq",
          "value": true,
          "sourceRef": {
            "integrationId": "{{integrationId}}",
            "integrationKey": "{{integrationKey}}",
            "configId": "{{configId}}",
            "behaviorDeviceKey": "aqara_cloud_device",
            "optionKey": "metric_above",
            "capability": "sensor.contact"
          }
        },
        "actions": [
          {
            "id": "refresh_device",
            "label": "Refresh Aqara device",
            "action": "refresh",
            "capability": "device.refresh",
            "sourceRef": {
              "integrationId": "{{integrationId}}",
              "integrationKey": "{{integrationKey}}",
              "configId": "{{configId}}",
              "behaviorDeviceKey": "aqara_cloud_device",
              "optionKey": "refresh",
              "capability": "device.refresh"
            },
            "target": {
              "mode": "selection",
              "configIds": [
                "{{configId}}"
              ]
            },
            "failure": {
              "strategy": "retry_then_continue",
              "retry": {
                "maxAttempts": 2,
                "delaySeconds": 2,
                "timeoutSeconds": 15,
                "backoff": "fixed"
              },
              "continueOnPartialFailure": true
            }
          }
        ],
        "safety": {
          "staleDataMode": "block",
          "maxAgeSeconds": 300,
          "requireFreshTrigger": true,
          "dryRunFirst": false
        },
        "failure": {
          "strategy": "follow_edges",
          "fallbackBehaviorId": "",
          "conditionTree": {
            "op": "and",
            "children": []
          }
        },
        "stop": {
          "never": true
        },
        "override": {
          "mode": "continue"
        }
      },
      "ui": {
        "accent": "security",
        "icon": "shield"
      },
      "metadata": {
        "recommended": true,
        "difficulty": "easy"
      }
    }
  ],
