              "name": "value",
              "label": "Threshold",
              "type": "number",
              "required": true
            }
          ],
          "capability": "sensor.metric_above",
          "operators": [
            ">",
            ">=",
            "<",
            "<=",
            "eq"
          ],
          "runtime": {
            "source": "state",
            "field": "metric_above",
            "operator": ">"
